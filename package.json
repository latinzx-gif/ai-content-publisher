    "smoke:agent-execution": "node scripts/smoke-agent-execution.mjs",
    "smoke:rag-workflow": "node scripts/smoke-rag-workflow.mjs",
    "smoke:prepare": "node scripts/prepare-smoke-fixture.mjs",
    "smoke:user": "node scripts/create-smoke-user.mjs",
    "smoke:prod": "node scripts/run-production-smoke.mjs",
    "smoke:cleanup": "node scripts/cleanup-smoke-data.mjs",
    "mvp:audit": "node scripts/audit-mvp-production.mjs",
    "review:changes": "node scripts/review-working-tree.mjs",
    "smoke:next": "node scripts/print-smoke-next-step.mjs",
