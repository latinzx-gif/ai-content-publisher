{
  "name": "head-office-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "daemon:agent": "node scripts/head-office-agent-daemon.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "deploy:check": "node scripts/check-deploy-readiness.mjs",
    "deploy:env:push": "node scripts/push-vercel-env.mjs",
    "deploy:env:dry-run": "AI_CONTENT_VERCEL_ENV_DRY_RUN=yes node scripts/push-vercel-env.mjs",
    "deploy:prod:preflight": "node scripts/predeploy-production-gate.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "smoke:auth": "node scripts/smoke-authenticated-flow.mjs",
    "smoke:backend-contracts": "node scripts/smoke-backend-contracts.mjs",
