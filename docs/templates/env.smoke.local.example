# Copy this file to `.env.smoke.local`.
# `.env*` files are ignored by git in this project.
# Do not commit real secret values.

NEXT_PUBLIC_SUPABASE_URL=https://luxegqsccaodcikxhwrm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Dedicated smoke/test user only. Do not use a real admin, lawyer, accountant, or customer.
AI_CONTENT_SMOKE_EMAIL=smoke-test@example.com
AI_CONTENT_CONFIRM_CREATE_SMOKE_USER=yes
AI_CONTENT_CONFIRM_SMOKE_USER=yes

# Written automatically by `npm run smoke:user` or `npm run smoke:prod`.
AI_CONTENT_BEARER_TOKEN=replace-with-dedicated-smoke-user-bearer-token
AI_CONTENT_SMOKE_PASSWORD=replace-with-generated-or-owned-smoke-password

# Written automatically by `npm run smoke:prepare` or `npm run smoke:prod`.
AI_CONTENT_SMOKE_CONTENT_ID=replace-after-smoke-prepare

# Use only when cleaning up dedicated smoke data after the production smoke run.
AI_CONTENT_CONFIRM_CLEANUP_SMOKE=yes
